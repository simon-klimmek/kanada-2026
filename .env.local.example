# Supabase - public keys (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase - secret key (SERVER ONLY, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private area password (hashed with bcrypt recommended)
PRIVATE_AREA_PASSWORD=your-private-password

# Admin email addresses (comma-separated)
ADMIN_EMAILS=simon@example.com,franzi@example.com
